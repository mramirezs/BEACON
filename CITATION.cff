    title: "BepiPred-3.0: Improved B-cell epitope prediction using protein language models"
    authors:
      - family-names: "Clifford"
        given-names: "Joakim N."
    year: 2022
    journal: "Protein Science"
    volume: 31
    issue: 12
    doi: "10.1002/pro.4497"
  - type: article
    title: "DiscoTope-3.0: Improved B-cell epitope prediction using inverse folding latent representations"
    authors:
      - family-names: "Høie"
        given-names: "Magnus H."
    year: 2024
    journal: "Frontiers in Immunology"
    volume: 15
    doi: "10.3389/fimmu.2024.1322712"
